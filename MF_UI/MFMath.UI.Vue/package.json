{
  "name": "mfmath-ui-vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MF-Mathematics 桌面端 HTML UI — Vue 3 + Vite 重写版（计算走 mf_mathematics.dll，经 C# MathBridge/WebView2）",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prune-fonts.mjs",
    "build:raw": "vite build",
    "preview": "vite preview",
    "tutorials": "node tools/build-tutorials.mjs",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:signatures": "node tools/engine-signatures.mjs --check",
    "check:ui": "node tools/build-tutorials.mjs && node tools/check-ui.mjs && node tools/check-examples.mjs",
    "signatures:write": "node tools/engine-signatures.mjs --write",
    "check": "npm run check:types && npm run check:signatures && npm run check:ui"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "katex": "^0.16.11",
    "mathlive": "^0.110.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.7"
  }
}
