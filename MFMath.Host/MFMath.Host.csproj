<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MFMath</AssemblyName>
    <!-- 本机版本：更新链拿它与站点 /api/version 的 latest 比较。
         必须显式声明 —— 靠默认的 1.0.0.0 会让"有没有新版"永远判错（站点报 1.2.0 时还会把
         v2 用户引去下载 v1 安装包，所以 UpdateBridge 是按"关系"判定的，见那里的注释）。 -->
    <Version>2.0.0</Version>
    <InformationalVersion>2.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!-- HTML UI：Vue 3 + Vite（MFMath.UI.Vue），Release 时把构建产物 dist 拷到输出 wwwroot
       前提：先在 MF_UI\MFMath.UI.Vue 下执行 npm install && npm run build
       Debug 构建指向 Vite dev server（MainWindow 里 http://127.0.0.1:5173），不依赖 wwwroot

       v2.0 变更：前端与宿主已同居同一目录树，此路径由原先跨树指向
       ..\..\MVS知识库\Multifunctional系列\Multifunctional-Mathematics\MF_UI\... 改为树内相对路径。
       旧版 MFMath.UI（原生 JS，未纳入 v2.0）如需回退，请自行引入后改成 ..\MF_UI\MFMath.UI\** -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Include="..\MF_UI\MFMath.UI.Vue\dist\**"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 控制台：Python 侧的引擎门面（安装组件时由宿主拷进组件目录） -->
  <ItemGroup>
    <Content Include="python\mfmath.py" Link="python\mfmath.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 控制台：C++ 侧的门面头文件（安装 C++ 组件时由宿主拷进组件目录；也可直接给用户拷走）
       mfmath_autorun.hpp 由宿主编译时用 -include 强制注入，用户不需要 include -->
  <ItemGroup>
    <Content Include="cpp\mfmath.hpp" Link="cpp\mfmath.hpp" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="cpp\mfmath_autorun.hpp" Link="cpp\mfmath_autorun.hpp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 引擎 DLL + 运行时依赖 -->
  <ItemGroup>
    <None Include="..\MF_Mathematics\build\bin\Release\mf_mathematics.dll" Link="mf_mathematics.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\MF_Mathematics\build\bin\Release\symengine-0.14.dll" Link="symengine-0.14.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\MF_Mathematics\build\bin\Release\flint-24.dll" Link="flint-24.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\MF_Mathematics\build\bin\Release\gmp-10.dll" Link="gmp-10.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\MF_Mathematics\build\bin\Release\mpfr-6.dll" Link="mpfr-6.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\MF_Mathematics\build\bin\Release\pthreadVC3.dll" Link="pthreadVC3.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
